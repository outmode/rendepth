static inline __attribute__((always_inline))
float bicubicWeight(thread const float& value)
{
    float absoluteValue = abs(value);
    if (absoluteValue <= 1.0)
    {
        return (0.666666686534881591796875 - (absoluteValue * absoluteValue)) + (((0.5 * absoluteValue) * absoluteValue) * absoluteValue);
    }
    if (absoluteValue < 2.0)
    {
        float distanceToEdge = 2.0 - absoluteValue;
        return ((distanceToEdge * distanceToEdge) * distanceToEdge) / 6.0;
    }
    return 0.0;
}

static inline __attribute__((always_inline))
float bicubicDepth(thread const float2& uv, thread const float& referenceDepth, constant DepthRefineData& _65, texture2d<float> depthTexture, sampler depthTextureSmplr)
{
    float2 pixel = (uv * _65.depthSize) - float2(0.5);
    float2 base = floor(pixel);
    float2 fraction = pixel - base;
    float depthDenominator = 0.007199999876320362091064453125;
    float result = 0.0;
    float totalWeight = 0.0;
    for (int y = -1; y <= 2; y++)
    {
        for (int x = -1; x <= 2; x++)
        {
            int2 samplePixel = clamp(int2(base) + int2(x, y), int2(0), int2(_65.depthSize) - int2(1));
            float2 offset = float2(float(x), float(y)) - fraction;
            float param = offset.x;
            float param_1 = offset.y;
            float weight = bicubicWeight(param) * bicubicWeight(param_1);
            float candidate = depthTexture.sample(depthTextureSmplr, ((float2(samplePixel) + float2(0.5)) / _65.depthSize)).x;
            float depthDifference = candidate - referenceDepth;
            weight *= exp((-(depthDifference * depthDifference)) / depthDenominator);
            result += (candidate * weight);
            totalWeight += weight;
        }
    }
    return result / fast::max(totalWeight, 9.9999997473787516355514526367188e-05);
}

