#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct DepthRefineData
{
    float2 depthSize;
    float spatialSigma;
    float colorSigma;
};

struct main0_out
{
    float4 outColor [[color(0)]];
};

struct main0_in
{
    float2 fragUV [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant DepthRefineData& _27 [[buffer(0)]], texture2d<float> colorTexture [[texture(0)]], texture2d<float> depthTexture [[texture(1)]], sampler colorTextureSmplr [[sampler(0)]], sampler depthTextureSmplr [[sampler(1)]])
{
    main0_out out = {};
    float3 guide = colorTexture.sample(colorTextureSmplr, in.fragUV).xyz;
    float2 depthPixel = (in.fragUV * _27.depthSize) - float2(0.5);
    int2 center = int2(floor(depthPixel));
    float spatialDenominator = (2.0 * _27.spatialSigma) * _27.spatialSigma;
    float colorDenominator = (2.0 * _27.colorSigma) * _27.colorSigma;
    float result = 0.0;
    float totalWeight = 0.0;
    for (int y = -2; y <= 2; y++)
    {
        for (int x = -2; x <= 2; x++)
        {
            int2 samplePixel = clamp(center + int2(x, y), int2(0), int2(_27.depthSize) - int2(1));
            float2 sampleUV = (float2(samplePixel) + float2(0.5)) / _27.depthSize;
            float candidate = depthTexture.sample(depthTextureSmplr, sampleUV).x;
            float3 candidateGuide = colorTexture.sample(colorTextureSmplr, sampleUV).xyz;
            float spatialDistance = float((x * x) + (y * y));
            float colorDistance = dot(guide - candidateGuide, guide - candidateGuide);
            float weight = exp(((-spatialDistance) / spatialDenominator) - (colorDistance / colorDenominator));
            result += (candidate * weight);
            totalWeight += weight;
        }
    }
    out.outColor = float4(float3(result / fast::max(totalWeight, 9.9999997473787516355514526367188e-05)), 1.0);
    return out;
}

