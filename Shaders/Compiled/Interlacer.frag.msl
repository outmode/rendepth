static inline __attribute__((always_inline))
float2 clampEdge(thread float2& inUV, thread const float2& minUV, thread const float2& maxUV)
{
    if (inUV.x < minUV.x)
    {
        inUV.x = (minUV.x - inUV.x) * 0.333000004291534423828125;
    }
    if (inUV.x > maxUV.x)
    {
        inUV.x = maxUV.x + ((maxUV.x - inUV.x) * 0.333000004291534423828125);
    }
    return fast::clamp(inUV, minUV, maxUV);
}

static inline __attribute__((always_inline))
float getDepth(texture2d<float> tex, sampler texSmplr, thread const float2& uv)
{
    float depthSample = 1.0 - tex.sample(texSmplr, fast::clamp(uv, float2(0.0), float2(1.0))).x;
    float ndc = (depthSample * 2.0) - 1.0;
    float linearDepth = 20.0 / (100.09999847412109375 - (ndc * 99.90000152587890625));
    linearDepth /= 99.90000152587890625;
    return linearDepth;
}

