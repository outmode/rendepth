#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct LanczosDataFrag
{
    float2 sourceSize;
    float2 targetSize;
};

struct main0_out
{
    float4 outColor [[color(0)]];
};

struct main0_in
{
    float2 fragUV [[user(locn0)]];
};

static inline __attribute__((always_inline))
float sinc(thread const float& x)
{
    if (abs(x) < 9.9999997473787516355514526367188e-06)
    {
        return 1.0;
    }
    float px = 3.1415927410125732421875 * x;
    return sin(px) / px;
}

static inline __attribute__((always_inline))
float lanczos3(thread const float& x)
{
    if (abs(x) >= 3.0)
    {
        return 0.0;
    }
    float param = x;
    float param_1 = x / 3.0;
    return sinc(param) * sinc(param_1);
}

fragment main0_out main0(main0_in in [[stage_in]], constant LanczosDataFrag& _60 [[buffer(0)]], texture2d<float> sourceTexture [[texture(0)]], sampler sourceTextureSmplr [[sampler(0)]])
{
    main0_out out = {};
    float2 pos = (in.fragUV * _60.sourceSize) - float2(0.5);
    float2 base = floor(pos);
    float2 fraction = pos - base;
    float4 colorSum = float4(0.0);
    float totalWeight = 0.0;
    float4 minColor = float4(1.0);
    float4 maxColor = float4(0.0);
    for (int y = -2; y <= 3; y++)
    {
        float param = float(y) - fraction.y;
        float wy = lanczos3(param);
        for (int x = -2; x <= 3; x++)
        {
            float param_1 = float(x) - fraction.x;
            float wx = lanczos3(param_1);
            float weight = wx * wy;
            int2 sampleCoord = clamp(int2(base) + int2(x, y), int2(0), int2(_60.sourceSize) - int2(1));
            float2 sampleUV = (float2(sampleCoord) + float2(0.5)) / _60.sourceSize;
            float4 sampleColor = sourceTexture.sample(sourceTextureSmplr, sampleUV);
            if ((((x >= 0) && (x <= 1)) && (y >= 0)) && (y <= 1))
            {
                minColor = fast::min(minColor, sampleColor);
                maxColor = fast::max(maxColor, sampleColor);
            }
            colorSum += (sampleColor * weight);
            totalWeight += weight;
        }
    }
    float4 filtered = colorSum / float4(fast::max(totalWeight, 9.9999997473787516355514526367188e-06));
    filtered = fast::clamp(filtered, minColor, maxColor);
    out.outColor = fast::clamp(filtered, float4(0.0), float4(1.0));
    return out;
}

