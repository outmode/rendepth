{
  "manifest_version": 3,
  "name": "Rendepth Companion",
  "version": "3.0",
  "minimum_chrome_version": "120",
  "description": "Send web photos and videos to the Rendepth desktop app for 3D viewing. Requires Rendepth.",
  "key": "",
  "icons": {
    "512": "icons/rendepth.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Open in Rendepth",
    "default_popup": "popup.html",
    "default_icon": "icons/rendepth.png"
  }
}
