<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleGetInfoString</key>
    <string>${MACOSX_BUNDLE_INFO_STRING}</string>
    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleLongVersionString</key>
    <string>${MACOSX_BUNDLE_LONG_VERSION_STRING}</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CSResourcesFileMapped</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>${MACOSX_BUNDLE_COPYRIGHT}</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Rendepth Image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>jpeg</string><string>jpg</string><string>jpe</string>
                <string>jfif</string><string>jif</string><string>jps</string>
                <string>png</string><string>pns</string><string>tga</string>
                <string>bmp</string><string>dib</string><string>tif</string>
                <string>tiff</string><string>ico</string><string>cur</string>
                <string>qoi</string><string>avifs</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Rendepth JPEG XL Image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>public.jpeg-xl</string></array>
            <key>CFBundleTypeExtensions</key>
            <array><string>jxl</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Rendepth AVIF Image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>public.avif</string></array>
            <key>CFBundleTypeExtensions</key>
            <array><string>avif</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Rendepth WebP Image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>org.webmproject.webp</string></array>
            <key>CFBundleTypeExtensions</key>
            <array><string>webp</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Rendepth Video and Disc Media</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>mp4</string><string>m4v</string><string>mov</string>
                <string>mkv</string><string>webm</string><string>avi</string>
                <string>wmv</string><string>mpeg</string><string>mpg</string>
                <string>vob</string><string>ifo</string><string>iso</string>
                <string>m2ts</string><string>ts</string><string>gif</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Rendepth Audio</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>aac</string><string>flac</string><string>m4a</string>
                <string>mp3</string><string>oga</string><string>ogg</string>
                <string>opus</string><string>wav</string>
            </array>
        </dict>
    </array>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>Rendepth reads connected Looking Glass displays and media on removable volumes.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Rendepth browses nearby media and saves 3D images and exports alongside files you open.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Rendepth browses nearby media and saves 3D images and exports alongside files you open.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Rendepth browses nearby media and saves 3D images and exports alongside files you open.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>Rendepth opens and exports media stored on network volumes you select.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Rendepth receives video from its browser extension over a local connection.</string>
</dict>
</plist>
